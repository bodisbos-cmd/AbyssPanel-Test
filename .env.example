# Local development only. Keep COOKIE_SECURE=0 on plain HTTP localhost.
DATA_DIR=./data
PORT=8080
COOKIE_SECURE=0
# Optional public URL override, e.g. https://your-domain.up.railway.app
# BASE_URL=

# Marzban integration. Keep MARZBAN_BACKEND disabled until the Abyss UI/API
# compatibility rollout and a real Marzban instance smoke test are complete.
# MARZBAN_BACKEND=0
# MARZBAN_BASE_URL=https://your-marzban-domain.example
# MARZBAN_ADMIN_USERNAME=admin
# MARZBAN_ADMIN_PASSWORD=replace-with-a-strong-secret
# MARZBAN_TIMEOUT_SECONDS=12
# JSON object of existing Marzban inbound tags; do not guess tag names.
# Example: {"vless":["VLESS WS"],"vmess":["VMess WS"]}
# MARZBAN_INBOUNDS_JSON={"vless":["REPLACE_WITH_REAL_VLESS_INBOUND_TAG"]}
