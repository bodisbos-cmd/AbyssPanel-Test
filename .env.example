# BASE_URL=
# Marzban API integration foundation only; do not configure until routes are migrated.
# MARZBAN_BASE_URL=https://your-marzban-domain.example
# MARZBAN_ADMIN_USERNAME=admin
# MARZBAN_ADMIN_PASSWORD=replace-with-a-strong-secret
# MARZBAN_TIMEOUT_SECONDS=12
